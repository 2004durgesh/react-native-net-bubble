# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'NetBubbleExample' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # ── NetBubble: auto-insert compose source maps build phase ───────────────
    # Adds a "NetBubble: compose source maps" run-script phase that fires after
    # "Bundle React Native code and images" to fuse the Hermes bytecode map
    # with the Metro packager map.  This enables offline symbolication (real
    # file:line origins in the Initiator tab) without a Metro server.
    #
    # The phase only runs for non-Release configurations (see the shell script).
    # Re-run `pod install` after adding or removing this block.
    app_project = Xcodeproj::Project.open('NetBubbleExample.xcodeproj')
    app_project.targets.each do |target|
      next unless target.name == 'NetBubbleExample'
      next if target.shell_script_build_phases.any? { |p| p.name == 'NetBubble: compose source maps' }

      phase = target.new_shell_script_build_phase('NetBubble: compose source maps')
      phase.shell_script = '"${SRCROOT}/../../scripts/netbubble-source-maps.sh"'

      # Move the new phase to immediately after "Bundle React Native code and images"
      bundle_idx = target.build_phases.index { |p|
        p.respond_to?(:name) && p.name.to_s.include?('Bundle React Native')
      }
      if bundle_idx
        phase_ref = target.build_phases.pop
        target.build_phases.insert(bundle_idx + 1, phase_ref)
      end

      puts "[NetBubble] Added 'compose source maps' build phase to #{target.name}"
    end
    app_project.save
  end
end
